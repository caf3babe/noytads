#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/noytads

start_service() {
	config_load noytads

	local enabled listen_port ca_path ca_key_path ca_export_port log_level
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return

	config_get listen_port main listen_port 8443
	config_get ca_path main ca_path /etc/noytads/ca.pem
	config_get ca_key_path main ca_key_path /etc/noytads/ca.key
	config_get ca_export_port main ca_export_port 8080
	config_get log_level main log_level warn

	procd_open_instance
	procd_set_param command "$PROG" \
		-listen ":${listen_port}" \
		-ca-path "${ca_path}" \
		-ca-key "${ca_key_path}" \
		-ca-export ":${ca_export_port}" \
		-log-level "${log_level}"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	setup_firewall "$listen_port"
}

stop_service() {
	cleanup_firewall
}

reload_service() {
	# Send SIGHUP for hot-reload of filter lists (Phase 4)
	local pid
	pid=$(pgrep -f "$PROG")
	[ -n "$pid" ] && kill -HUP "$pid"
}

setup_firewall() {
	local port="$1"

	# Redirect HTTPS traffic from LAN to the proxy
	iptables -t nat -C PREROUTING -i br-lan -p tcp --dport 443 \
		-j REDIRECT --to-port "$port" 2>/dev/null || \
	iptables -t nat -A PREROUTING -i br-lan -p tcp --dport 443 \
		-j REDIRECT --to-port "$port"

	# Block QUIC (UDP 443) to force HTTP/2 over TCP fallback
	# Without this, Safari may use QUIC and bypass the proxy entirely
	iptables -C FORWARD -p udp --dport 443 -j REJECT 2>/dev/null || \
	iptables -A FORWARD -p udp --dport 443 -j REJECT
}

cleanup_firewall() {
	iptables -t nat -D PREROUTING -i br-lan -p tcp --dport 443 \
		-j REDIRECT --to-port 8443 2>/dev/null
	iptables -D FORWARD -p udp --dport 443 -j REJECT 2>/dev/null
}
